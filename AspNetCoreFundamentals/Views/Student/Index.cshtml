@model IEnumerable<AspNetCoreFundamentals.Models.Student>

@{
    ViewData["Title"] = "Students";

    var students = Model.ToList();
    var totalStudents = students.Count;
    var activeStudents = students.Count(s => s.IsActive);
}

<div class="container mt-4">

    <img src="~/images/school.png" alt="Student Image" />

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>@ViewData["Title"]</h1>
            <p class="text-muted">Manage students</p>
        </div>

        <!-- Add New Student -->
        <a asp-action="Create" class="btn btn-primary">
            + Add New Student
        </a>
    </div>

    <!-- Variables -->
    <div class="mb-4">
        <p>Total Students: @totalStudents</p>
        <p>Active Students: @activeStudents</p>
    </div>

    <!-- if / else -->
    @if (students.Any())
    {
        <div class="row">
            @* partial view here start *@
            <partial name="_StudentList" model="students" />

        </div>
        <!-- foreach -->
    }
    else
    {
        <div class="alert alert-info">
            No students found.
        </div>
    }

</div>