@model IEnumerable<AspNetCoreFundamentals.Models.Student>

@{
    ViewData["Title"] = "Students";

    var students = Model.ToList();
    var totalStudents = students.Count;
    var activeStudents = students.Count(s => s.IsActive);
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>@ViewData["Title"]</h1>
            <p class="text-muted">Manage students</p>
        </div>

        <!-- Add New Student -->
        <a asp-action="Create" class="btn btn-primary">
            + Add New Student
        </a>
    </div>

    <!-- Variables -->
    <div class="mb-4">
        <p>Total Students: @totalStudents</p>
        <p>Active Students: @activeStudents</p>
    </div>

    <!-- if / else -->
    @if (students.Any())
    {
        <div class="row">

            <!-- foreach -->
            @foreach (var student in students)
            {
                <div class="col-md-4 mb-3">

                    <div class="card shadow-sm">
                        <div class="card-body">

                            <!-- Razor Expression -->
                            <h5 class="card-title">
                                @student.Name
                            </h5>

                            <p>
                                Age: @student.Age
                            </p>

                            <p>
                                Email: @student.Email
                            </p>

                            <!-- Nested if / else -->
                            @if (student.IsActive)
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Inactive
                                </span>
                            }

                            <div class="mt-3">

                                <!-- Edit -->
                                <a asp-action="Edit"
                                   asp-route-id="@student.Id"
                                   class="btn btn-warning">
                                    Edit
                                </a>

                                <!-- Delete -->
                                <form asp-action="Delete"
                                      asp-route-id="@student.Id"
                                      method="post"
                                      class="d-inline">

                                    <button type="submit"
                                            class="btn btn-danger"
                                            onclick="return confirm('Are you sure you want to delete this student?');">
                                        Delete
                                    </button>

                                </form>

                            </div>

                        </div>
                    </div>

                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No students found.
        </div>
    }

</div>