@foreach (var student in Model)
{
    <div class="col-md-4 mb-3">

        <div class="card shadow-sm">
            <div class="card-body">

                <!-- Razor Expression -->
                <h5 class="card-title">
                    @student.Name
                </h5>

                <p>
                    Age: @student.Age
                </p>

                <p>
                    Email: @student.Email
                </p>

                <!-- Nested if / else -->
                @if (student.IsActive)
                {
                    <span class="badge bg-success">
                        Active
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        Inactive
                    </span>
                }

                <!-- Show / Hide Button -->
                <button type="button"
                        class="btn btn-info mt-3"
                        onclick="toggleDetails('@student.Id')">
                    Show Details
                </button>

                <!-- Student Details -->
                <div id="student-details-@student.Id"
                     style="display: none;"
                     class="mt-3">

                    <p>
                        Age: @student.Age
                    </p>

                    <p>
                        Email: @student.Email
                    </p>

                </div>

                <div class="mt-3">


                    <!-- Edit -->
                    <a asp-action="Edit"
                       asp-route-id="@student.Id"
                       class="btn btn-warning">
                        Edit
                    </a>

                    <!-- Delete -->
                    <form asp-action="Delete"
                          asp-route-id="@student.Id"
                          method="post"
                          class="d-inline">

                        <button type="submit"
                                class="btn btn-danger"
                                onclick="return confirm('Are you sure you want to delete this student?');">
                            Delete
                        </button>

                    </form>

                </div>

            </div>
        </div>

    </div>
}

<script>
    function toggleDetails(studentId) {

        var details = document.getElementById("student-details-" + studentId);

        if (details.style.display === "none") {
            details.style.display = "block";
        }
        else {
            details.style.display = "none";
        }
    }
</script>