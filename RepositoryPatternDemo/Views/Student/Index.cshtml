@model List<RepositoryPatternDemo.Models.Student>

<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <h2 class="mb-0 text-secondary"><i class="bi bi-people me-2"></i>Students List</h2>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Add Student
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 80px;">Id</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Department</th>
                        <th class="text-end pe-4" style="width: 320px;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var student in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted">@student.Id</td>
                                <td class="fw-semibold">@student.Name</td>
                                <td class="text-muted">@student.Email</td>
                                <td>
                                    @if (student.Department != null)
                                    {
                                        <span class="badge bg-info text-dark rounded-pill px-3 py-2"><i class="bi bi-building me-1"></i>@student.Department.Name</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill px-3 py-2">N/A</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Transfer" asp-route-id="@student.Id" class="btn btn-sm btn-outline-primary me-1" title="Transfer">
                                        <i class="bi bi-arrow-left-right"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-sm btn-outline-info me-1" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-sm btn-outline-warning me-1" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@student.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox display-4 d-block mb-3"></i>
                                No students found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>