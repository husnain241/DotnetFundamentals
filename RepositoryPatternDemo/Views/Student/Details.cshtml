@model RepositoryPatternDemo.Models.Student

<div class="row justify-content-center mt-4">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-info text-white py-3">
                <h4 class="mb-0"><i class="bi bi-person-vcard me-2"></i>Student Details</h4>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0 fs-5">
                    <dt class="col-sm-4 text-muted mb-3"><i class="bi bi-hash me-2"></i>Id</dt>
                    <dd class="col-sm-8 mb-3 fw-bold">@Model.Id</dd>

                    <dt class="col-sm-4 text-muted mb-3"><i class="bi bi-person me-2"></i>Name</dt>
                    <dd class="col-sm-8 mb-3">@Model.Name</dd>

                    <dt class="col-sm-4 text-muted mb-3"><i class="bi bi-envelope me-2"></i>Email</dt>
                    <dd class="col-sm-8 mb-3">@Model.Email</dd>

                    <dt class="col-sm-4 text-muted mb-3"><i class="bi bi-building me-2"></i>Department</dt>
                    <dd class="col-sm-8 mb-3">
                        @if (Model.Department != null)
                        {
                            <span class="badge bg-info text-dark rounded-pill px-3 py-2"><i class="bi bi-building me-1"></i>@Model.Department.Name</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary rounded-pill px-3 py-2">N/A</span>
                        }
                    </dd>
                </dl>
            </div>
            <div class="card-footer bg-light p-3 d-flex justify-content-between align-items-center">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to List
                </a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4">
                    <i class="bi bi-pencil me-1"></i>Edit
                </a>
            </div>
        </div>
    </div>
</div>