@model RepositoryPatternDemo.Models.Department

<div class="row justify-content-center mt-4">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-info text-white py-3">
                <h4 class="mb-0"><i class="bi bi-info-square me-2"></i>Department Details</h4>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0 fs-5">
                    <dt class="col-sm-5 text-muted mb-3"><i class="bi bi-hash me-2"></i>Id</dt>
                    <dd class="col-sm-7 mb-3 fw-bold">@Model.Id</dd>

                    <dt class="col-sm-5 text-muted mb-3"><i class="bi bi-building me-2"></i>Name</dt>
                    <dd class="col-sm-7 mb-3 text-primary fw-semibold">@Model.Name</dd>

                    <dt class="col-sm-5 text-muted mb-3"><i class="bi bi-people me-2"></i>Student Count</dt>
                    <dd class="col-sm-7 mb-3">
                        <span class="badge bg-success rounded-pill px-3 py-2">
                            <i class="bi bi-person-lines-fill me-1"></i> @Model.StudentCount Enrolled
                        </span>
                    </dd>
                </dl>
            </div>
            <div class="card-footer bg-light p-3 d-flex justify-content-between align-items-center">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to List
                </a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4">
                    <i class="bi bi-pencil me-1"></i>Edit
                </a>
            </div>
        </div>
    </div>
</div>
