@model RepositoryPatternDemo.Models.Department

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm mt-3">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Delete Department</h4>
            </div>
            <div class="card-body">
                <p class="text-danger fw-bold">Are you sure you want to delete this department?</p>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Id:</dt>
                    <dd class="col-sm-8">@Model.Id</dd>

                    <dt class="col-sm-4">Name:</dt>
                    <dd class="col-sm-8">@Model.Name</dd>
                </dl>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <form asp-action="DeleteConfirmed" method="post" class="d-inline">
                    <input asp-for="Id" type="hidden" />
                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
