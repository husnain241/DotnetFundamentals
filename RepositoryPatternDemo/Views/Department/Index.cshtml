@model List<RepositoryPatternDemo.Models.Department>

<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <h2 class="mb-0 text-secondary"><i class="bi bi-building me-2"></i>Departments List</h2>
    <a asp-action="Create" class="btn btn-success shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Add Department
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 80px;">Id</th>
                        <th>Department Name</th>
                        <th>Student Count</th>
                        <th class="text-end pe-4" style="width: 280px;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var department in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted">@department.Id</td>
                                <td class="fw-semibold text-primary">@department.Name</td>
                                <td>
                                    <span class="badge bg-success rounded-pill px-3 py-2">
                                        <i class="bi bi-person-lines-fill me-1"></i> @department.StudentCount Enrolled
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@department.Id" class="btn btn-sm btn-outline-info me-1" title="Details">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@department.Id" class="btn btn-sm btn-outline-warning me-1" title="Edit">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@department.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox display-4 d-block mb-3"></i>
                                No departments found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>