@model RepositoryPatternDemo.Models.Department

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm mt-3">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0">Edit Department</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">

                    <input asp-for="Id" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label font-weight-bold">Department Name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between pt-2">
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-warning">Update Department</button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>
