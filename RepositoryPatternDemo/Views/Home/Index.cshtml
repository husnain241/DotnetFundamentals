@{
    ViewData["Title"] = "Dashboard";
}

<div class="text-center mb-5 mt-4">
    <h1 class="display-4 fw-bold text-primary mb-3">
        <i class="bi bi-mortarboard-fill"></i> Welcome to the Student Portal
    </h1>
    <p class="lead text-muted">Manage your students and departments efficiently using the Repository and Unit of Work patterns.</p>
</div>

<div class="row justify-content-center">
    <div class="col-md-5 mb-4">
        <div class="card shadow-sm h-100 border-0 border-top border-primary border-4">
            <div class="card-body text-center py-5">
                <i class="bi bi-people display-1 text-primary mb-3"></i>
                <h3 class="card-title">Students</h3>
                <p class="card-text text-muted mb-4">Manage student records, enrollments, and execute department transfers.</p>
                <a asp-controller="Student" asp-action="Index" class="btn btn-primary btn-lg px-4 rounded-pill">
                    Manage Students <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-5 mb-4">
        <div class="card shadow-sm h-100 border-0 border-top border-success border-4">
            <div class="card-body text-center py-5">
                <i class="bi bi-building display-1 text-success mb-3"></i>
                <h3 class="card-title">Departments</h3>
                <p class="card-text text-muted mb-4">Manage academic departments and view total student enrollments.</p>
                <a asp-controller="Department" asp-action="Index" class="btn btn-success btn-lg px-4 rounded-pill">
                    Manage Departments <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </div>
</div>
