@model mini_project_SMS.ViewModels.StudentViewModel

@{
    ViewData["Title"] = "Add Student";
}

<div class="student-page">

    <div class="page-header">
        <div>
            <h1>Add Student</h1>
            <p>Create a new student record.</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to Students
        </a>
    </div>

    <div class="form-card">

        <form asp-action="Create" method="post" enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="Student.Name" class="form-label">
                        Student Name
                    </label>

                    <input asp-for="Student.Name"
                           class="form-control"
                           placeholder="Enter student name" />

                    <span asp-validation-for="Student.Name"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Student.Email" class="form-label">
                        Email
                    </label>

                    <input asp-for="Student.Email"
                           type="email"
                           class="form-control"
                           placeholder="student@example.com" />

                    <span asp-validation-for="Student.Email"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Student.Age" class="form-label">
                        Age
                    </label>

                    <input asp-for="Student.Age"
                           type="number"
                           class="form-control"
                           placeholder="Enter age" />

                    <span asp-validation-for="Student.Age"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Student.DepartmentId" class="form-label">
                        Department
                    </label>

                    <select asp-for="Student.DepartmentId"
                            class="form-select"
                            asp-items="@(new SelectList(Model.Departments, "Id", "Name"))">

                        <option value="">-- Select Department --</option>

                    </select>

                    <span asp-validation-for="Student.DepartmentId"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-12 mb-3">
                    <label asp-for="Image" class="form-label">
                        Student Image
                    </label>

                    <input asp-for="Image"
                           type="file"
                           class="form-control"
                           accept="image/*" />

                    <span asp-validation-for="Image"
                          class="text-danger">
                    </span>

                    <span class="text-danger">
                        @Html.ValidationMessage("image")
                    </span>
                </div>

            </div>

            <div class="form-actions">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-primary">
                    Save Student
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}